    <sbol:ComponentReference rdf:about="https://sbolstandard.org/examples/MulticellularSystem/ComponentReference2">
        <sbol:displayId>ComponentReference2</sbol:displayId>
        <sbol:inChildOf rdf:resource="https://sbolstandard.org/examples/MulticellularSystem/SubComponent2"/>
