    <sbol:Constraint rdf:about="https://sbolstandard.org/examples/MulticellularSystem/Constraint1">
        <sbol:displayId>Constraint1</sbol:displayId>
        <sbol:object rdf:resource="https://sbolstandard.org/examples/MulticellularSystem/ComponentReference2"/>
        <sbol:restriction rdf:resource="http://sbols.org/v3#verifyIdentical"/>
        <sbol:subject rdf:resource="https://sbolstandard.org/examples/MulticellularSystem/ComponentReference1"/>
    </sbol:Constraint>
</rdf:RDF>
