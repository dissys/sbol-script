    <sbol:ComponentReference rdf:about="https://sbolstandard.org/examples/MulticellularSystem/ComponentReference1">
        <sbol:displayId>ComponentReference1</sbol:displayId>
        <sbol:inChildOf rdf:resource="https://sbolstandard.org/examples/MulticellularSystem/SubComponent1"/>
