    <sbol:Component rdf:about="https://sbolstandard.org/examples/AHL">
        <sbol:description>AHL</sbol:description>
        <sbol:displayId>AHL</sbol:displayId>
        <sbol:hasNamespace rdf:resource="https://sbolstandard.org/examples"/>
