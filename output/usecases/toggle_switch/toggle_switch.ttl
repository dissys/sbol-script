exa:toggle_switch
    a sbol:Component;
    sbol:description "Toggle Switch genetic circuit";
    sbol:displayId "toggle_switch";
    sbol:hasConstraint tog:Constraint1, tog:Constraint2;
    sbol:hasFeature
        tog:ComponentReference1, tog:ComponentReference2,
        tog:ComponentReference3, tog:ComponentReference4, tog:SubComponent1,
        tog:SubComponent2;
    sbol:hasNamespace sbo:examples;
    sbol:name "Toggle Switch";
    sbol:role <https://identifiers.org/SO:0000704>;
    sbol:type <https://identifiers.org/SBO:0000251>.
tog:ComponentReference1
    a sbol:ComponentReference;
    sbol:displayId "ComponentReference1";
    sbol:inChildOf tog:SubComponent1;
    sbol:refersTo LacI:SubComponent7 .
