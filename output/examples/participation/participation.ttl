@prefix sbol: <http://sbols.org/v3#>.
@prefix exa: <https://sbolstandard.org/examples/>.
@prefix E: <https://sbolstandard.org/examples/E0040/>.
@prefix sbo: <https://sbolstandard.org/>.
@prefix Seq: <https://sbolstandard.org/examples/E0040/SequenceFeature1/>.
@prefix i: <https://sbolstandard.org/examples/i13504/>.
@prefix i0: <https://sbolstandard.org/examples/i13504_system/>.
@prefix Int: <https://sbolstandard.org/examples/i13504_system/Interaction1/>.
@prefix In: <https://sbolstandard.org/examples/i13504_system/Interaction2/>.
@prefix Sub: <https://sbolstandard.org/examples/i13504/SubComponent1/>.

exa:E0040
    a sbol:Component;
    sbol:description "gfp coding sequence";
    sbol:displayId "E0040";
    sbol:hasFeature E:SequenceFeature1;
    sbol:hasNamespace sbo:examples;
    sbol:hasSequence exa:E0040_Sequence1;
    sbol:name "gfp";
    sbol:role <https://identifiers.org/SO:0000316>;
    sbol:type <https://identifiers.org/SBO:0000251>.
exa:E0040_Sequence1
    a sbol:Sequence;
    sbol:description "E0040 sequence";
    sbol:displayId "E0040_Sequence1";
    sbol:elements
        "";
    sbol:encoding <https://identifiers.org/edam:format_1207>;
    sbol:hasNamespace sbo:examples;
    sbol:name "Sequence1".
E:SequenceFeature1
    a sbol:SequenceFeature;
    sbol:displayId "SequenceFeature1";
    sbol:hasLocation Seq:EntireSequence1 .
Seq:EntireSequence1
    a sbol:EntireSequence;
    sbol:displayId "EntireSequence1";
    sbol:hasSequence exa:gfp_start.
exa:GFP_protein
    a sbol:Component;
    sbol:description "GFP";
    sbol:displayId "GFP_protein";
    sbol:hasNamespace sbo:examples;
    sbol:name "GFP";
    sbol:type <https://identifiers.org/SBO:0000252>.
exa:gfp_start
a sbol:Sequence; sbol:displayId "gfp_start"; sbol:hasNamespace sbo:examples.
exa:i13504
    a sbol:Component;
    sbol:displayId "i13504";
    sbol:hasFeature i:SubComponent1;
    sbol:hasNamespace sbo:examples;
    sbol:hasSequence exa:i13504_Sequence1;
    sbol:role <https://identifiers.org/SO:0000704>;
    sbol:type <https://identifiers.org/SBO:0000251>.
exa:i13504_Sequence1
    a sbol:Sequence;
    sbol:description "i13504 sequence";
    sbol:displayId "i13504_Sequence1";
    sbol:elements
        "";
    sbol:encoding <https://identifiers.org/edam:format_1207>;
    sbol:hasNamespace sbo:examples;
    sbol:name "Sequence1".
exa:i13504_system
    a sbol:Component;
    sbol:displayId "i13504_system";
    sbol:hasFeature i0:ComponentReference1, i0:SubComponent1, i0:SubComponent2;
    sbol:hasInteraction i0:Interaction1, i0:Interaction2;
    sbol:hasNamespace sbo:examples;
    sbol:name "i13504 system";
    sbol:role
    <https://identifiers.org/SBO:0000289>, <https://identifiers.org/SO:0000704>;
    sbol:type <https://identifiers.org/SBO:0000251>.
i0:ComponentReference1
    a sbol:ComponentReference;
    sbol:displayId "ComponentReference1";
    sbol:inChildOf i0:SubComponent1;
    sbol:refersTo i:SubComponent1 .
i0:Interaction1
    a sbol:Interaction;
    sbol:displayId "Interaction1";
    sbol:hasParticipation Int:Participation1, Int:Participation2;
    sbol:type <https://identifiers.org/SBO:0000589>.
Int:Participation1
    a sbol:Participation;
    sbol:displayId "Participation1";
    sbol:participant i0:ComponentReference1;
    sbol:role <https://identifiers.org/SBO:0000645>.
Int:Participation2
    a sbol:Participation;
    sbol:displayId "Participation2";
    sbol:participant i0:SubComponent2;
    sbol:role <https://identifiers.org/SBO:0000011>.
i0:Interaction2
    a sbol:Interaction;
    sbol:displayId "Interaction2";
    sbol:hasParticipation In:Participation1;
    sbol:type <https://identifiers.org/SBO:0000169>.
In:Participation1
    a sbol:Participation;
    sbol:displayId "Participation1";
    sbol:higherOrderParticipant i0:Interaction1;
    sbol:role <https://identifiers.org/SBO:0000020>.
i0:SubComponent1
a sbol:SubComponent; sbol:displayId "SubComponent1"; sbol:instanceOf exa:i13504 .
i0:SubComponent2
    a sbol:SubComponent;
    sbol:displayId "SubComponent2";
    sbol:instanceOf exa:GFP_protein.
i:SubComponent1
    a sbol:SubComponent;
    sbol:displayId "SubComponent1";
    sbol:hasLocation Sub:Range1;
    sbol:instanceOf exa:E0040;
    sbol:orientation <https://identifiers.org/SO:0001030>.
Sub:Range1
    a sbol:Range;
    sbol:displayId "Range1";
    sbol:end "720";
    sbol:hasSequence exa:i13504_Sequence1;
    sbol:orientation <https://identifiers.org/SO:0001030>;
    sbol:start "1".
exa:TetR
    a sbol:Component;
    sbol:displayId "TetR";
    sbol:hasNamespace sbo:examples;
    sbol:type <https://identifiers.org/SBO:0000252>.
