<rdf:RDF
 xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
 xmlns:sbol="http://sbols.org/v3#">
    <sbol:Component rdf:about="https://sbolstandard.org/examples/LacI_protein">
        <sbol:description>LacI protein</sbol:description>
        <sbol:displayId>LacI_protein</sbol:displayId>
        <sbol:hasNamespace rdf:resource="https://sbolstandard.org/examples"/>
        <sbol:name>LacI</sbol:name>
        <sbol:role rdf:resource="https://identifiers.org/GO:0003700"/>
        <sbol:type rdf:resource="https://identifiers.org/SBO:0000252"/>
    </sbol:Component>
    <sbol:Component rdf:about="https://sbolstandard.org/examples/TetR_protein">
        <sbol:description>TetR protein</sbol:description>
        <sbol:displayId>TetR_protein</sbol:displayId>
        <sbol:hasNamespace rdf:resource="https://sbolstandard.org/examples"/>
        <sbol:name>TetR</sbol:name>
        <sbol:role rdf:resource="https://identifiers.org/GO:0003700"/>
        <sbol:type rdf:resource="https://identifiers.org/SBO:0000252"/>
    </sbol:Component>
    <sbol:Component rdf:about="https://sbolstandard.org/examples/aTC">
        <sbol:description>aTC</sbol:description>
        <sbol:displayId>aTC</sbol:displayId>
        <sbol:hasNamespace rdf:resource="https://sbolstandard.org/examples"/>
        <sbol:name>aTC</sbol:name>
        <sbol:role rdf:resource="https://identifiers.org/CHEBI:35224"/>
        <sbol:type rdf:resource="https://identifiers.org/SBO:0000247"/>
    </sbol:Component>
    <sbol:Component rdf:about="https://sbolstandard.org/examples/LacI_producer">
        <sbol:description>LacI producer</sbol:description>
        <sbol:displayId>LacI_producer</sbol:displayId>
        <sbol:hasFeature rdf:resource="https://sbolstandard.org/examples/LacI_producer/SubComponent1"/>
        <sbol:hasFeature rdf:resource="https://sbolstandard.org/examples/LacI_producer/SubComponent2"/>
        <sbol:hasFeature rdf:resource="https://sbolstandard.org/examples/LacI_producer/SubComponent3"/>
        <sbol:hasInterface rdf:resource="https://sbolstandard.org/examples/LacI_producer/Interface1"/>
        <sbol:hasNamespace rdf:resource="https://sbolstandard.org/examples"/>
        <sbol:name>LacI produce</sbol:name>
        <sbol:role rdf:resource="https://identifiers.org/SO:0000704"/>
        <sbol:type rdf:resource="https://identifiers.org/SBO:0000251"/>
    </sbol:Component>
    <sbol:SubComponent rdf:about="https://sbolstandard.org/examples/LacI_producer/SubComponent1">
        <sbol:displayId>SubComponent1</sbol:displayId>
        <sbol:instanceOf rdf:resource="https://sbolstandard.org/examples/LacI_protein"/>
    </sbol:SubComponent>
    <sbol:SubComponent rdf:about="https://sbolstandard.org/examples/LacI_producer/SubComponent2">
        <sbol:displayId>SubComponent2</sbol:displayId>
        <sbol:instanceOf rdf:resource="https://sbolstandard.org/examples/TetR_protein"/>
    </sbol:SubComponent>
    <sbol:SubComponent rdf:about="https://sbolstandard.org/examples/LacI_producer/SubComponent3">
        <sbol:displayId>SubComponent3</sbol:displayId>
        <sbol:instanceOf rdf:resource="https://sbolstandard.org/examples/aTC"/>
    </sbol:SubComponent>
    <sbol:Interface rdf:about="https://sbolstandard.org/examples/LacI_producer/Interface1">
        <sbol:displayId>Interface1</sbol:displayId>
        <sbol:input rdf:resource="https://sbolstandard.org/examples/LacI_producer/SubComponent1"/>
        <sbol:input rdf:resource="https://sbolstandard.org/examples/LacI_producer/SubComponent2"/>
        <sbol:nondirectional rdf:resource="https://sbolstandard.org/examples/LacI_producer/SubComponent3"/>
        <sbol:output rdf:resource="https://sbolstandard.org/examples/LacI_producer/SubComponent1"/>
    </sbol:Interface>
</rdf:RDF>
