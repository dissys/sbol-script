@prefix sbol: <http://sbols.org/v3#>.
@prefix om: <http://www.ontology-of-units-of-measure.org/resource/om-2/>.
@prefix exa: <https://sbolstandard.org/examples/>.
@prefix sbo: <https://sbolstandard.org/>.
@prefix M: <https://sbolstandard.org/examples/M9_Glucose_CAA/>.
@prefix Ext: <https://sbolstandard.org/examples/M9_Glucose_CAA/ExternallyDefined1/>.

exa:cubicMeter
    a sbol:TopLevel, om:UnitExponentiation;
    sbol:displayId "cubicMeter";
    sbol:hasNamespace sbo:examples;
    sbol:name "cubicMeter";
    om:hasBase exa:meter;
    om:hasExponent "3";
    om:label "cubicMeter";
    om:symbol "m3".
exa:kelvin
    a sbol:TopLevel, om:SingularUnit;
    sbol:displayId "kelvin";
    sbol:hasNamespace sbo:examples;
    sbol:name "kelvin";
    om:label "kelvin";
    om:symbol "kelvin".
exa:kelvinMole
    a sbol:TopLevel, om:UnitMultiplication;
    sbol:displayId "kelvinMole";
    sbol:hasNamespace sbo:examples;
    sbol:name "kelvinMole";
    om:hasTerm1 exa:kelvin;
    om:hasTerm2 exa:mole;
    om:label "kelvinMole";
    om:symbol "K mol".
exa:litre
    a sbol:TopLevel, om:SingularUnit;
    sbol:description
    "The litre is a unit of volume defined as 1.0e-3 cubic metre.";
    sbol:displayId "litre";
    sbol:hasNamespace sbo:examples;
    sbol:name "liter";
    om:alternativeLabel "liter", "litre2";
    om:alternativeSymbol "L", "L2";
    om:comment "The litre is a unit of volume defined as 1.0e-3 cubic metre.";
    om:hasFactor "0.001";
    om:label "liter";
    om:longcomment "This is an example long comment.";
    om:symbol "l".
exa:M9_Glucose_CAA
    a sbol:Component;
    sbol:description "M9 Glucose CAA growth media";
    sbol:displayId "M9_Glucose_CAA";
    sbol:hasFeature M:ExternallyDefined1;
    sbol:hasNamespace sbo:examples;
    sbol:name "M9 Glucose CAA";
    sbol:type <https://identifiers.org/SBO:0000241>.
M:ExternallyDefined1
    a sbol:ExternallyDefined;
    sbol:definition <https://identifiers.org/CHEBI:3312>;
    sbol:displayId "ExternallyDefined1";
    sbol:hasMeasure Ext:measure1;
    sbol:type <https://identifiers.org/SBO:0000247>.
Ext:measure1
    a sbol:Identified, om:Measure;
    sbol:displayId "measure1";
    sbol:type
        <https://identifiers.org/SBO:0000196>,
        <https://identifiers.org/SBO:0000197>;
    om:hasNumericalValue "0.1";
    om:hasUnit exa:millimolePerLitre.
exa:meter
    a sbol:TopLevel, om:SingularUnit;
    sbol:displayId "meter";
    sbol:hasNamespace sbo:examples;
    sbol:name "meter";
    om:label "meter";
    om:symbol "m".
exa:milli
    a sbol:TopLevel, om:SIPrefix;
    sbol:description "Comment for the milli prefix.";
    sbol:displayId "milli";
    sbol:hasNamespace sbo:examples;
    sbol:name "milli";
    om:alternativeLabel "milli1", "milli2";
    om:alternativeSymbol "m1", "m2";
    om:comment "Comment for the milli prefix.";
    om:hasFactor "0.001";
    om:label "milli";
    om:longcomment "This is an example long comment for the milli prefix.";
    om:symbol "m".
exa:millimole
    a sbol:TopLevel, om:PrefixedUnit;
    sbol:displayId "millimole";
    sbol:hasNamespace sbo:examples;
    sbol:name "millimole";
    om:hasPrefix exa:milli;
    om:hasUnit exa:mole;
    om:label "millimole";
    om:symbol "mmol".
exa:millimolePerLitre
    a sbol:TopLevel, om:UnitDivision;
    sbol:displayId "millimolePerLitre";
    sbol:hasNamespace sbo:examples;
    sbol:name "millimolar";
    om:hasDenominator exa:litre;
    om:hasNumerator exa:millimole;
    om:label "millimolar";
    om:symbol "mmol/l".
exa:mole
    a sbol:TopLevel, om:SingularUnit;
    sbol:displayId "mole";
    sbol:hasNamespace sbo:examples;
    sbol:name "mole";
    om:label "mole";
    om:symbol "mol".
